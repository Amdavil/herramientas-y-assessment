# ============================================================================
#  Agente de Ingresos Nocturno  —  variables de entorno
#  Copia este archivo como  .env  y completa lo que tengas. NADA es obligatorio
#  para probar: sin claves, el agente corre en modo SIMULADO (offline).
#  NO subas .env a git.
# ============================================================================

# ── Búsqueda web ────────────────────────────────────────────────────────────
# Clave del proveedor activo (se elige en config.json -> busqueda.proveedor).
# Sirve para Tavily (recomendado/gratis hasta cierto límite), Exa, Brave, SerpAPI o Google CSE.
# Consíguela gratis en https://app.tavily.com
SEARCH_API_KEY=

# Solo si usas Google Custom Search (proveedor "google_cse"): ID del motor (cx).
GOOGLE_CSE_ID=

# ── IA: estrategia nocturna + estructuración de oportunidades ────────────────
# Prioridad automática: Claude > Groq > Gemini. Con cualquiera funciona; sin ninguna, modo offline.
ANTHROPIC_API_KEY=
# Groq es GRATIS y muy rápido: https://console.groq.com
GROQ_API_KEY=
# Gemini es GRATIS en AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── (Opcional) Aviso por correo del plan de acción de la mañana ──────────────
# Cuenta Gmail + App Password (https://myaccount.google.com/apppasswords)
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
# A dónde te llega el resumen (por defecto, a ti mismo)
ALERT_EMAIL=
