# ── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── LinkedIn ─────────────────────────────────────────────────
# Token OAuth 2.0 con scope w_organization_social
LINKEDIN_ACCESS_TOKEN=AQV...

# ID numérico de tu página de empresa en LinkedIn
# (lo encontrás en la URL: linkedin.com/company/ESTE-NUMERO/admin/)
LINKEDIN_ORG_ID=123456789

# ── Contexto de la empresa (opcional, mejora la personalización) ──
COMPANY_NAME=Nombre de tu empresa
INDUSTRY_CONTEXT=Consultoría estratégica y transformación organizacional en Latinoamérica
